# BIGCHAMP ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure values for local or container deployment.

ENV=development
PORT=3050

# Database
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=bigchamp

# Security Secrets (Generate secure random strings in production)
JWT_SECRET=super_secret_jwt_key_bigchamp_dev_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
QR_SIGNING_SECRET=super_secret_qr_signing_key_bigchamp_dev_1234567890

# Razorpay Test-Mode Sandbox Configuration
# Obtain your Test Key ID and Secret from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
PAYMENT_MODE=test

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3050","http://localhost:80","http://localhost"]
